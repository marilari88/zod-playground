{
  "name": "zod-playground",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "rm -rf dist/ && tsc && vite build",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:perf && npm run test:e2e",
    "test:unit": "node --test tests/zod.unit.ts",
    "test:perf": "node --test tests/zod.perf.ts",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps chromium firefox",
    "test:uninstall": "playwright uninstall --all",
    "biome:ci": "biome ci",
    "biome:check": "biome check",
    "biome:write": "biome check --write"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@monaco-editor/react": "^4.7.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "monaco-editor": "0.56.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
