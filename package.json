{
  "name": "zod-playground",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "rm -rf dist/ && tsc && vite build",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:perf && npm run test:e2e",
    "test:unit": "node --test tests/*.unit.ts",
    "test:perf": "node --test tests/*.perf.ts",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install --with-deps chromium firefox",
    "test:uninstall": "playwright uninstall --all",
    "biome:ci": "biome ci",
    "biome:check": "biome check",
    "biome:write": "biome check --write"
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@monaco-editor/react": "^4.7.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.4",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "monaco-editor": "0.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
